# --- Provider API Secrets (never commit real values) ---
OPENAI_API_KEY=replace-with-openai-api-key
GEMINI_API_KEY=replace-with-gemini-api-key
WATSON_API_KEY=replace-with-watson-api-key
WATSON_PROJECT_ID=replace-with-watsonx-project-id
WATSON_API_BASE_URL=https://us-south.ml.cloud.ibm.com
WATSON_FOUNDATION_MODEL_ID=ibm/granite-3-8b-instruct

# --- Authentication Secrets ---
JWT_SECRET_KEY=replace-with-cryptographically-random-secret-at-least-32-chars
ALLOWED_GITHUB_USERNAMES=replace-with-comma-separated-github-usernames
GITHUB_OAUTH_CLIENT_ID=replace-with-github-oauth-client-id
GITHUB_OAUTH_CLIENT_SECRET=replace-with-github-oauth-client-secret
GITHUB_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/auth/github/callback
JWT_TOKEN_EXPIRATION_SECONDS=3600

# --- Runtime Configuration ---
PORT=8000
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_FIDUCIARY_MODEL_NAME=llama3.2
APPLICATION_ENVIRONMENT=development
FEDERATOR_INSTANCE_IDENTIFIER=nlip-angel-filter-federator